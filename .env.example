# ============================================================
# Database — Neon Postgres
# ============================================================
# Vercel's Neon integration sets this for you. For local development point it
# at any Postgres; the app picks the driver from the host, so a plain local
# instance works without Neon.
#
# Apply db/schema.sql once before first use.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ============================================================
# Auth — PIN Login
# ============================================================
# Generate both with:   node scripts/setup-auth.js
# The script prints your PIN once; it is never stored in the project.
#
# Changing EITHER value signs out every existing session, so rotating the PIN
# also revokes access on a lost device.
AUTH_PIN_HASH=scrypt$16384$8$1$REPLACE_ME$REPLACE_ME
SESSION_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES
